# Copie para servidor/config.env (fora do git) e preencha.
# Variáveis de ambiente de mesmo nome têm prioridade sobre este arquivo.

# Home Assistant: URL e um Long-Lived Access Token (Perfil → Segurança)
HA_URL=http://homeassistant.local:8123
HA_TOKEN=

# Gemini API (Google AI Studio). Fica só no servidor: nunca vai para o navegador
# de fora nem para o firmware.
GEMINI_API_KEY=

# Senha do WebSocket /dispositivo. Gere uma e use a mesma no menuconfig do firmware:
#   python3 -c "import secrets; print(secrets.token_urlsafe(18))"
RLIGHT_TERMINAL_TOKEN=

# Como o assistente chama você
RLIGHT_USUARIO=você

# 127.0.0.1 = só a página no próprio computador; 0.0.0.0 = o terminal S3 alcança.
# De fora do localhost só o /dispositivo responde (e só com o token).
RLIGHT_BIND=0.0.0.0
RLIGHT_PORT=8765
RLIGHT_VOZ=Leda
# RLIGHT_MODELO=models/gemini-3.8-live

# Agente em segundo plano (opcional): investigações demoradas com o Claude Code
# (`claude -p`, somente leitura do HA). Precisa do CLI instalado e de um token do
# `claude setup-token`.
RLIGHT_AGENTE=0
CLAUDE_CODE_OAUTH_TOKEN=

# OTA do terminal: onde o firmware/ota.sh coloca o .bin que o terminal baixa
# (GET /firmware.bin?token=…)
# RLIGHT_FIRMWARE=/var/lib/rlight-live/rlight_terminal.bin
