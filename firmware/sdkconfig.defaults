# ESP32-S3 N16R8: 16 MB flash, 8 MB PSRAM octal
CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_ESP32S3_DATA_CACHE_64KB=y
CONFIG_ESP32S3_DATA_CACHE_LINE_64B=y
CONFIG_ESP32S3_INSTRUCTION_CACHE_32KB=y
CONFIG_FREERTOS_HZ=1000
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192

# ESP-SR: palavra "Alexa" (WakeNet 9, treinado com vozes reais: o mais confiável dos
# prontos de uma palavra só; o WakeNet 10 não cabe na RAM interna junto com o Wi-Fi) + VADNet
CONFIG_SR_WN_WN9_ALEXA=y
CONFIG_SR_VADN_VADNET1_MEDIUM=y

# RLight: servidor e token ficam no sdkconfig.segredos (fora do git), ex.:
#   CONFIG_RLIGHT_WIFI_SSID="minha-rede"
#   CONFIG_RLIGHT_WIFI_SENHA="..."
#   CONFIG_RLIGHT_SERVIDOR="ws://192.168.1.10:8765/dispositivo"
#   CONFIG_RLIGHT_TOKEN="o mesmo RLIGHT_TERMINAL_TOKEN do servidor"

# rede: ~32 KB/s de mic subindo e ~32 KB/s de voz descendo com sinal fraco; os buffers
# padrão (5,7 KB ≈ 180 ms) enchiam num engasgo do Wi-Fi e o websocket caía
CONFIG_LWIP_TCP_SND_BUF_DEFAULT=32768
CONFIG_LWIP_TCP_WND_DEFAULT=32768
CONFIG_LWIP_TCP_RECVMBOX_SIZE=32
CONFIG_ESP_WIFI_TX_BA_WIN=16
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER_NUM=48

# OTA com volta automática: o firmware novo só fica se conectar no servidor (main.c)
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y

# Sem frequência dinâmica (PM): sem lock a CPU fica em 80 MHz e o AFE com AEC travava a
# fala. RX do Wi-Fi fora da IRAM: sobram ~24 KB de RAM interna (com ela, 14,5 KB e a
# conversa caía com transport_poll_write)
# CONFIG_ESP_WIFI_RX_IRAM_OPT is not set

# Wi-Fi sempre acordado: em modem sleep o que chega do servidor anda a ~4 KB/s (OTA caía,
# avisos falados arrastados). Custa ~10-20 mA na bateria
# CONFIG_RLIGHT_ECONOMIA_WIFI is not set

# Controle de carga da UPS (opcional, ver README "Controle de carga"):
#   CONFIG_RLIGHT_CARGA_GPIO=11    CE do 4056 via PNP 2N3906
#   CONFIG_RLIGHT_TOMADA_GPIO=10   divisor 100k/100k do 5V de entrada
